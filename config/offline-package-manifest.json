{
  "package_name": "SM_Automation Linux Server and Windows Desktop",
  "version": "0.2.0",
  "offline": true,
  "server": {
    "platform": "linux",
    "requirements": "requirements-runtime.txt",
    "entrypoint": "scripts/run_server.py",
    "transport": "TLS/TCP",
    "port": 7443,
    "data_directory": "./DATA",
    "backup_directory": "./BACKUP"
  },
  "gui": {
    "platform": "windows-x64",
    "requirements": "requirements-gui.txt",
    "entrypoint": "scripts/run_desktop.py"
  },
  "prepare_script": "scripts/prepare_offline_packages.py",
  "provision_script": "scripts/provision_server.py",
  "instructions": "docs/deployment.md"
}
